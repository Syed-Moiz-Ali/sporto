{
  "info": {
    "name": "Sporto | Referee - Weekly Availability",
    "_postman_id": "ba2d77a5-32ac-49ae-bcf4-5acffb98eb64",
    "description": "Referee weekly working-hours CRUD. Requires an existing referee profile and Bearer {{referee_token}}. Uses {{referee_base_url}}, matching existing Sporto Referee Postman collections. Slots are recurring weekly Asia/Kolkata hours, NOT date-specific unbooked/bookable slots. All write examples mutate the connected environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{referee_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Read-only / Reference",
      "description": "Run these first; no database mutations.",
      "item": [
        {
          "name": "Get available weekdays",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/days",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "days"
              ]
            },
            "description": "GET all seven uppercase day constants, MONDAY ... SUNDAY."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"All 7 weekday constants\", () => { pm.expect(data.data).to.have.length(7); pm.expect(data.data[0].code).to.eql(\"MONDAY\"); pm.expect(data.data[6].code).to.eql(\"SUNDAY\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List my weekly availability",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability"
              ]
            },
            "description": "Lists weekly recurring slots for logged-in referee, sorted Monday first."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Time zone and slots\", () => { pm.expect(data.data.timezone).to.eql(\"Asia/Kolkata\"); pm.expect(data.data.slots).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Create / Update / Delete",
      "description": "Run in order. Write operations change saved referee availability.",
      "item": [
        {
          "name": "Create MONDAY 06:00-11:00",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability"
              ]
            },
            "description": "Create morning slot, save ID to availability_slot_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"MONDAY\",\n  \"start_time\": \"06:00\",\n  \"end_time\": \"11:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Slot fields\", () => { pm.expect(data.data.day).to.eql(\"MONDAY\"); pm.expect(data.data.start_time).to.eql(\"06:00\"); pm.expect(data.data.end_time).to.eql(\"11:00\"); pm.expect(data.data.timezone).to.eql(\"Asia/Kolkata\"); });",
                  "if (data?.data?.id) pm.collectionVariables.set(\"availability_slot_id\", String(data.data.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update created slot to MONDAY 06:30-11:30",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/{{availability_slot_id}}",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "{{availability_slot_id}}"
              ]
            },
            "description": "Full update of previously created slot.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"MONDAY\",\n  \"start_time\": \"06:30\",\n  \"end_time\": \"11:30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id=pm.collectionVariables.get(\"availability_slot_id\");",
                  "if(!id) { console.warn(\"Create a slot first to populate availability_slot_id.\"); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Updated time\", () => { pm.expect(data.data.start_time).to.eql(\"06:30\"); pm.expect(data.data.end_time).to.eql(\"11:30\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete created slot",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/{{availability_slot_id}}",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "{{availability_slot_id}}"
              ]
            },
            "description": "Delete saved example slot; clear collection variable."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id=pm.collectionVariables.get(\"availability_slot_id\");",
                  "if(!id) { console.warn(\"Create a slot first to populate availability_slot_id.\"); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.collectionVariables.unset(\"availability_slot_id\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Additional non-overlapping slot",
      "description": "Illustrates a second non-overlapping window on Monday.",
      "item": [
        {
          "name": "Create MONDAY 14:00-17:00",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability"
              ]
            },
            "description": "Create another slot, store afternoon ID separately.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"MONDAY\",\n  \"start_time\": \"14:00\",\n  \"end_time\": \"17:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Afternoon interval\", () => { pm.expect(data.data.day).to.eql(\"MONDAY\"); pm.expect(data.data.start_time).to.eql(\"14:00\"); });",
                  "if (data?.data?.id) pm.collectionVariables.set(\"availability_afternoon_slot_id\",String(data.data.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete afternoon slot",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/{{availability_afternoon_slot_id}}",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "{{availability_afternoon_slot_id}}"
              ]
            },
            "description": "Clean up afternoon example."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.collectionVariables.get(\"availability_afternoon_slot_id\")) { console.warn(\"Create an afternoon slot first.\"); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.collectionVariables.unset(\"availability_afternoon_slot_id\");"
                ]
              }
            }
          ]
        }
      ]
    },
