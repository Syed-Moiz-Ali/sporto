    {
      "name": "05 - Destructive / Run Manually",
      "description": "Caution: deletes every slot on a given weekday. Explicitly set availability_delete_day.",
      "item": [
        {
          "name": "Clear all slots for selected weekday",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/days/{{availability_delete_day}}",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "days",
                "{{availability_delete_day}}"
              ]
            },
            "description": "Danger: deletes all saved slots on availability_delete_day for the current referee. Variable blank by default."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const day=pm.collectionVariables.get(\"availability_delete_day\");",
                  "if(![\"MONDAY\",\"TUESDAY\",\"WEDNESDAY\",\"THURSDAY\",\"FRIDAY\",\"SATURDAY\",\"SUNDAY\"].includes(day)) { console.warn(\"Explicitly set availability_delete_day to an uppercase weekday.\"); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Deleted count\", () => pm.expect(data.data.deleted_slots).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        }
      ]
    },
