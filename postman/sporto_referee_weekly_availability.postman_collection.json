  ],
  "variable": [
    {
      "key": "referee_base_url",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Server origin only. Change to your test/UAT server."
    },
    {
      "key": "referee_token",
      "value": "",
      "type": "string",
      "description": "Paste authenticated referee token; never commit real tokens."
    },
    {
      "key": "availability_slot_id",
      "value": "",
      "type": "string",
      "description": "Set after example create."
    },
    {
      "key": "availability_afternoon_slot_id",
      "value": "",
      "type": "string",
      "description": "Set after afternoon create."
    },
    {
      "key": "availability_delete_day",
      "value": "",
      "type": "string",
      "description": "Must set explicitly before clear-all-by-weekday."
    }
  ]
