    {
      "name": "03 - Additional non-overlapping slot",
      "description": "Illustrates multiple intervals on one weekday; run after the main CRUD folder, or adjust times if Monday has other slots.",
      "item": [
        {
          "name": "Create MONDAY 14:00-17:00",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability"
              ]
            },
            "description": "Creates a separate afternoon slot. Saves to availability_afternoon_slot_id; this will not overwrite the first ID.\n\nstart_time supports HH:mm[:ss]; nonzero seconds round-trip unchanged. Local booking clock is validated in timezone before deriving UTC scheduled instants.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"MONDAY\",\n  \"start_time\": \"14:00\",\n  \"end_time\": \"17:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Second interval\", () => { pm.expect(data.data.day).to.eql(\"MONDAY\"); pm.expect(data.data.start_time).to.eql(\"14:00\"); });",
                  "if (data?.data?.id) pm.collectionVariables.set(\"availability_afternoon_slot_id\",String(data.data.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete afternoon slot",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/{{availability_afternoon_slot_id}}",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "{{availability_afternoon_slot_id}}"
              ]
            },
            "description": "Cleans up the afternoon example."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"availability_afternoon_slot_id\")) { console.warn(\"Create the afternoon example first.\"); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.collectionVariables.unset(\"availability_afternoon_slot_id\");"
                ]
              }
            }
          ]
        }
