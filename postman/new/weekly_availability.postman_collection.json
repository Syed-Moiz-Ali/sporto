        {
          "name": "Create MONDAY 06:00-11:00",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability"
              ]
            },
            "description": "Creates an early morning slot, and stores data.id as availability_slot_id for subsequent requests. 24-hour local time.\n\nstart_time supports HH:mm[:ss]; nonzero seconds round-trip unchanged. Local booking clock is validated in timezone before deriving UTC scheduled instants.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"MONDAY\",\n  \"start_time\": \"06:00\",\n  \"end_time\": \"11:00\",\n  \"is_enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Returned time interval\", () => { pm.expect(data.data.day).to.eql(\"MONDAY\"); pm.expect(data.data.start_time).to.eql(\"06:00\"); pm.expect(data.data.end_time).to.eql(\"11:00\"); pm.expect(data.data.timezone).to.eql(\"Asia/Kolkata\"); });",
                  "if (data?.data?.id) pm.collectionVariables.set(\"availability_slot_id\",String(data.data.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update created slot to MONDAY 06:30-11:30",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/{{availability_slot_id}}",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "{{availability_slot_id}}"
              ]
            },
            "description": "Full replace, all three fields required. Requires an ID saved by the preceding POST.\n\nstart_time supports HH:mm[:ss]; nonzero seconds round-trip unchanged. Local booking clock is validated in timezone before deriving UTC scheduled instants.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"MONDAY\",\n  \"start_time\": \"06:30\",\n  \"end_time\": \"11:30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id=pm.collectionVariables.get(\"availability_slot_id\");",
                  "if(!id) { console.warn(\"Create a slot first to populate availability_slot_id.\"); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Updated time\", () => { pm.expect(data.data.start_time).to.eql(\"06:30\"); pm.expect(data.data.end_time).to.eql(\"11:30\"); });"
                ]
              }
            }
          ]
        },
