{
  "info": {
    "name": "Sporto | Referee - Weekly Availability",
    "_postman_id": "ba2d77a5-32ac-49ae-bcf4-5acffb98eb64",
    "description": "Daily and Weekly availability: seven-day overview, persistent day and slot toggles, partial updates, destructive deletes, and separate global online status. Uses Asia/Kolkata local recurring hours. has_configured_hours describes enabled saved hours; has_available_hours also requires approved/active/online status. Specific-date discovery and calendar check conflicts separately. Write examples mutate the selected environment; run only against authorized fixtures. Existing variables and authentication follow the canonical Referee collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{referee_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Read-only / Reference",
      "description": "Run these first; no database mutations.",
      "item": [
        {
          "name": "Get available weekdays",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/days",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "days"
              ]
            },
            "description": "GET all seven uppercase constant codes MONDAY ... SUNDAY."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Seven weekday constants, Monday first\", () => { pm.expect(data.data).to.have.length(7); pm.expect(data.data[0].code).to.eql(\"MONDAY\"); pm.expect(data.data[6].code).to.eql(\"SUNDAY\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List my weekly availability",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability"
              ]
            },
            "description": "Lists only the authenticated referee's weekly slots (Monday-first). A referee profile must exist."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Time zone and slots array\", () => { pm.expect(data.data.timezone).to.eql(\"Asia/Kolkata\"); pm.expect(data.data.slots).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List selected day",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability?day=MONDAY",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability"
              ],
              "query": [
                {
                  "key": "day",
                  "value": "MONDAY"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Seven day overview\", () => pm.expect(pm.response.json().data.days).to.have.lengthOf(7));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read global online status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/status",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Create / Update / Delete",
      "description": "Run in order. These operations change the authenticated referee's stored availability. Create stores the returned ID in {{availability_slot_id}}.",
      "item": [
        {
