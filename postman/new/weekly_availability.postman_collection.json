                "api",
                "v1",
                "referee",
                "availability",
                "days",
                "MONDAY"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
