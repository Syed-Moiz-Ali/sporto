    {
      "name": "05 - Destructive / Run Manually",
      "description": "CAUTION: This endpoint deletes ALL your availability intervals for the selected day. Set availability_delete_day explicitly to MONDAY ... SUNDAY before running; blank value skips.",
      "item": [
        {
          "name": "Clear all slots for selected weekday",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{referee_base_url}}/api/v1/referee/availability/days/{{availability_delete_day}}",
              "host": [
                "{{referee_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "referee",
                "availability",
                "days",
                "{{availability_delete_day}}"
              ]
            },
            "description": "Danger: clears all slots for the selected weekday for the signed-in referee. Set {{availability_delete_day}} deliberately before sending; leave empty to prevent accidental deletion in runner."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const day=pm.variables.get(\"availability_delete_day\");",
                  "if(![\"MONDAY\",\"TUESDAY\",\"WEDNESDAY\",\"THURSDAY\",\"FRIDAY\",\"SATURDAY\",\"SUNDAY\"].includes(day)) { console.warn(\"Explicitly set availability_delete_day to an uppercase weekday before deleting all slots.\"); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Sporto envelope\", () => { pm.expect(data.success).to.eql(true); pm.expect(data).to.have.property(\"data\"); });",
                  "pm.test(\"Deleted slot count available\", () => pm.expect(data.data.deleted_slots).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        }
      ]
    },
